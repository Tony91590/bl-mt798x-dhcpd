+++ b/atf-20220606-637ba581b/configs/mt7981_360t7_defconfig
@@ -1,5 +1,5 @@
 CONFIG_PLAT_MT7981=y
-CONFIG_TARGET_FIP_NO_SEC_BOOT=y
+CONFIG_TARGET_ALL_NO_SEC_BOOT=y
 CONFIG_FLASH_DEVICE_SPIM_NAND=y
 CONFIG_BGA=y
 CONFIG_LOG_LEVEL_INFO=y
diff --git a/atf-20220606-637ba581b/configs/mt7981_cmcc_rax3000m-emmc_defconfig b/atf-20220606-637ba581b/configs/mt7981_cmcc_rax3000m-emmc_defconfig
index 6063debe882..d5238dee9f5 100644
--- a/atf-20220606-637ba581b/configs/mt7981_cmcc_rax3000m-emmc_defconfig
+++ b/atf-20220606-637ba581b/configs/mt7981_cmcc_rax3000m-emmc_defconfig
@@ -1,5 +1,5 @@
