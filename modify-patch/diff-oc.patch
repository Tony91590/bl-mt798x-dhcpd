 CONFIG_PLAT_MT7981=y
 CONFIG_DRAM_DDR4=y
-CONFIG_TARGET_FIP_NO_SEC_BOOT=y
+CONFIG_TARGET_ALL_NO_SEC_BOOT=y
 CONFIG_FLASH_DEVICE_SPIM_NAND=y
